{
  "name": "themap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:data": "tsx data/build.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:data && npm run validate && npm test && npm run typecheck && vite build && npm run verify:build",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --import tsx tests/*.test.ts",
    "build:fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "maplibre-gl": "^6.19.0",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "fontnik": "^0.7.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
